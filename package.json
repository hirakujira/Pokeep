{
  "name": "pokemon-go-recording-assistant",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "data:update": "node --import tsx scripts/update-data.ts",
    "video:inspect": "node --import tsx scripts/inspect-video.ts",
    "references:validate": "node --import tsx scripts/validate-references.ts"
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0",
    "lucide-react": "^0.468.0",
    "next": "16.4.3",
    "openai": "^6.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sharp": "^0.35.5",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
